APP_NAME=TheArtainment
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.YOURDOMAIN.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=stderr
LOG_LEVEL=error

# --- Database: Supabase Postgres ---
# Use EITHER DB_URL (Supabase connection URI) OR the individual DB_* fields below.
# DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DB_CONNECTION=pgsql
DB_HOST=db.PROJECT.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Media storage: Supabase Storage (S3-compatible) ---
# Set FILESYSTEM_PUBLIC_DRIVER=s3 and the values below so uploads persist on
# the free tier (the PHP host's local disk is ephemeral). Create a PUBLIC
# bucket in Supabase Storage named in SUPABASE_BUCKET.
# Get the S3 credentials from Supabase → Storage → Settings → S3 Connection.
FILESYSTEM_PUBLIC_DRIVER=s3
FILESYSTEM_PUBLIC_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/YOUR-BUCKET
SUPABASE_ACCESS_KEY=YOUR_SUPABASE_S3_ACCESS_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_S3_SECRET_KEY
SUPABASE_BUCKET=YOUR-BUCKET
SUPABASE_ENDPOINT=https://YOUR-PROJECT.supabase.co/storage/v1/s3
SUPABASE_REGION=us-east-1
SUPABASE_USE_PATH_STYLE=true

SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=

# --- CORS: exact origin of the Vercel frontend ---
# The frontend sends `credentials: 'include'`, so this must be the precise
# Vercel URL (https only) — not a wildcard.
FRONTEND_URL=https://YOUR-VERCEL-APP.vercel.app

# --- Mail (configure to a real SMTP provider) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@YOURDOMAIN.com
MAIL_FROM_NAME="${APP_NAME}"
