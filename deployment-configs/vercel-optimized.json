{
  "version": 2,
  "name": "artainment-frontend",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "env": {
    "VITE_API_BASE_URL": "@vite_api_base_url",
    "VITE_APP_URL": "@vite_app_url"
  },
  "build": {
    "env": {
      "VITE_API_BASE_URL": "@vite_api_base_url",
      "VITE_APP_URL": "@vite_app_url"
    }
  },
  "rewrites": [
    { 
      "source": "/((?!api/).*)", 
      "destination": "/index.html" 
    }
  ]
}