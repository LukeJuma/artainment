# Supabase Backend Environment Configuration (Free Tier Optimized)

# Application
APP_NAME=TheArtainment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-project.supabase.co/functions/v1/api
APP_KEY=your-laravel-app-key

# Database (Supabase PostgreSQL - Free: 500MB)
DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require

# Storage (Supabase Storage - Free: 1GB)
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DRIVER=s3
FILESYSTEM_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/media
SUPABASE_ACCESS_KEY=your-s3-access-key
SUPABASE_SECRET_KEY=your-s3-secret-key  
SUPABASE_BUCKET=media
SUPABASE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_REGION=us-east-1
SUPABASE_USE_PATH_STYLE=true

# Sessions & Cache (Database for free tier)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=your-app.vercel.app
CACHE_DRIVER=database
CACHE_PREFIX=art_

# Queue (Database for free tier)
QUEUE_CONNECTION=database

# CORS & Security
FRONTEND_URL=https://your-app.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# Broadcasting (Log for free tier)
BROADCAST_DRIVER=log

# Mail (Use free service like Resend - 3000 emails/month free)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=your-resend-api-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=stderr
LOG_LEVEL=error