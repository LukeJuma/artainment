# Namecheap Hosting Configuration
# Copy these values to your artainment-backend/.env file

# Application
APP_NAME="The Artainment"
APP_ENV=production
APP_KEY=base64:QT/mQ/l792QhVN0cjmgHF2Bh842928DEUBvyrmhoBbQ=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Frontend URL (Update with your actual domain)
FRONTEND_URL=https://yourdomain.com

# Database - Keep your existing Supabase PostgreSQL
DB_CONNECTION=pgsql
