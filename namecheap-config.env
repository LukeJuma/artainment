DB_DATABASE=postgres
DB_USERNAME=postgres.etjkivwwnqafyphqamgh
DB_PASSWORD=Q_UChkn8n8yYj.k
DB_SSLMODE=require

# Storage - Keep your existing Supabase Storage
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DRIVER=s3
FILESYSTEM_PUBLIC_URL=https://etjkivwwnqafyphqamgh.supabase.co/storage/v1/object/public/media

AWS_ACCESS_KEY_ID=bc3a6d253fa00d87de161e68c5396273
AWS_SECRET_ACCESS_KEY=23875c491e9cd050d41769c4649f9af76c5a87abe720d9115f7e8b501a7669c1
