AWS_BUCKET=media
AWS_ENDPOINT=https://etjkivwwnqafyphqamgh.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# Cache & Session (File-based for shared hosting)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Broadcasting (File/Log based for shared hosting)
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# JWT Configuration
JWT_SECRET=SecureJwtSecretKey256BitMinimumForHS256Algorithm
JWT_EXPIRATION=86400

# Mail Configuration (Update with your Namecheap email settings)
